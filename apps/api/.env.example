# Copy this file to .env (in this folder) and adjust if needed.
# These values match docker-compose.yml and are for local development only.

# The database the API uses when you run it.
DATABASE_URL="postgresql://tessera:tessera@localhost:5432/tessera"

# The database the automated tests use. The tests delete its data.
TEST_DATABASE_URL="postgresql://tessera:tessera@localhost:5432/tessera_test"

# File storage: any S3-compatible store. These match docker-compose.yml
# (SeaweedFS) and are for local development only.
S3_ENDPOINT="http://localhost:8333"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="tessera"
S3_SECRET_ACCESS_KEY="tessera-local-secret"
# "true" for SeaweedFS and MinIO (bucket in the path); "false" for AWS S3.
S3_FORCE_PATH_STYLE="true"
# The bucket the API uses when you run it. It is made at start if missing.
S3_BUCKET="tessera-files"

# The bucket the automated tests use. The tests delete what is in it.
TEST_S3_BUCKET="tessera-files-test"

# The largest file, in megabytes (whole number, 1 to 10240). Default: 100.
FILE_SIZE_LIMIT_MB=100
