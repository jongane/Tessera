// Tessera database schema. See docs/data-model.md for the full design.
// Times are stored with their time zone (timestamptz), as teams may be spread
// across zones. Tables and columns use snake_case in the database (@@map / @map),
// while TypeScript code uses camelCase.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  // Lets the schema describe partial unique indexes (see Thread).
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String          @id @default(uuid()) @db.Uuid
  email        String          @unique
  displayName  String          @map("display_name")
  passwordHash String          @map("password_hash")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  memberships  ProjectMember[]
  createdCards Card[]
  timeEntries  TimeEntry[]
  runningTimer RunningTimer?

  @@map("users")
}

model Project {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  // Short capitals that start card numbers, e.g. WEB in WEB-12.
  // Must be 2 to 6 capital letters (check constraint in the migration).
  code           String          @unique @db.VarChar(6)
  // The number the next top-level card gets. Only ever goes up, so numbers
  // are never reused, even after a card is deleted.
  nextCardNumber Int             @default(1) @map("next_card_number")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  members        ProjectMember[]
  boards         Board[]
  codes          ProjectCode[]
  cards          Card[]
  timeEntries    TimeEntry[]
  runningTimers  RunningTimer[]
  labels         Label[]

  @@map("projects")
}

enum ProjectRole {
  ADMIN
  MEMBER

  @@map("project_role")
}

// Who belongs to a project, and with which role.
// A user can belong to a project only once (composite primary key).
model ProjectMember {
  projectId     String         @map("project_id") @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  role          ProjectRole    @default(MEMBER)
  joinedAt      DateTime       @default(now()) @map("joined_at") @db.Timestamptz(3)
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Leaving the project removes the person's card assignments.
  assignedCards CardAssignee[]

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

// Every code a project has ever had, its current one included, so old card
// numbers like OLD-12 still lead to the card after the code changes.
// The code is the primary key, so no two projects can ever share a code,
// whether it is current or old.
model ProjectCode {
  code      String   @id @db.VarChar(6)
  projectId String   @map("project_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_codes")
}

// A kanban board and chat space inside a project.
model Board {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns   Column[]
  cards     Card[]
  threads   Thread[]

  // Lets cards point at (board, project) together. See Card.board.
  @@unique([id, projectId])
  @@index([projectId])
  @@map("boards")
}

// A kanban column. Columns are shown in `position` order (lowest first).
model Column {
  id        String   @id @default(uuid()) @db.Uuid
  boardId   String   @map("board_id") @db.Uuid
  name      String
  position  Int
  // Moving a card into a done column completes it. New boards mark Done.
  isDone    Boolean  @default(false) @map("is_done")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     Card[]

  // Lets cards point at (column, board) together, so a card can only sit in
  // a column of its own board.
  @@unique([id, boardId])
  @@index([boardId, position])
  @@map("columns")
}

// A task or user story. Cards are shown in `position` order within a column.
model Card {
  id                String            @id @default(uuid()) @db.Uuid
  projectId         String            @map("project_id") @db.Uuid
  boardId           String            @map("board_id") @db.Uuid
  // The card's number without the project code: "12" for WEB-12, "12.1"
  // for its first subtask. Unique within the project; format checked by a
  // constraint in the migration.
  numberPath        String            @map("number_path")
  // The number the card's next subtask gets ("12.3" when this is 3). Only
  // ever goes up, so a subtask number is never reused.
  nextSubtaskNumber Int               @default(1) @map("next_subtask_number")
  // A subtask's parent card: same project, any board. Null for a top-level card.
  parentId          String?           @map("parent_id") @db.Uuid
  // 0 for a top-level card, 1 for its subtasks, down to 4 (5 levels in all).
  // Checked by constraints in the migration.
  depth             Int               @default(0)
  isComplete        Boolean           @default(false) @map("is_complete")
  // Set exactly when isComplete is true (check constraint in the migration).
  completedAt       DateTime?         @map("completed_at") @db.Timestamptz(3)
  columnId          String            @map("column_id") @db.Uuid
  title             String
  description       String?
  // The card's own estimate in minutes; null when none is set. A card with
  // subtasks shows the sum of theirs instead (card-totals.service.ts).
  estimateMinutes   Int?              @map("estimate_minutes")
  position          Int
  priority          CardPriority      @default(NONE)
  // When the card is due. Without a time (dueHasTime false) it is midnight
  // UTC of the due day. Both checked by constraints in the migration.
  dueAt             DateTime?         @map("due_at") @db.Timestamptz(3)
  dueHasTime        Boolean           @default(false) @map("due_has_time")
  // Who created the card; they and admins may delete it. Null for cards
  // made before this was recorded, or whose creator was deleted.
  createdById       String?           @map("created_by_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  // Points at (board, project) so the card's project is always its board's.
  board             Board             @relation(fields: [boardId, projectId], references: [id, projectId], onDelete: Cascade)
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // NoAction: a column with cards cannot be deleted, but deleting the whole
  // board still removes both (the check runs at the end of the statement).
  column            Column            @relation(fields: [columnId, boardId], references: [id, boardId], onDelete: NoAction)
  createdBy         User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  assignees         CardAssignee[]
  labels            CardLabel[]
  thread            Thread?
  // Points at (parent, project) so a parent is always in the same project.
  // NoAction: a card with subtasks cannot be deleted directly;
  // CardsService.deleteCard asks what to do with each subtask first.
  parent            Card?             @relation("Subtasks", fields: [parentId, projectId], references: [id, projectId], onDelete: NoAction, onUpdate: NoAction)
  subtasks          Card[]            @relation("Subtasks")
  oldNumbers        CardNumberAlias[]
  timeEntries       TimeEntry[]
  runningTimers     RunningTimer[]

  // Lets threads point at (card, board) together. See Thread.card.
  @@unique([id, boardId])
  @@unique([projectId, numberPath])
  // Lets subtasks and old numbers point at (card, project) together.
  @@unique([id, projectId])
  @@index([parentId])
  @@index([boardId])
  @@index([columnId, position])
  @@index([createdById])
  @@map("cards")
}

enum CardPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("card_priority")
}

enum ThreadKind {
  // The board's own chat. Every board has exactly one, never linked to a card.
  GENERAL
  // Any other chat. It may be linked to one card.
  TOPIC

  @@map("thread_kind")
}

// A chat conversation on a board.
// Database rules (see docs/data-model.md):
// - at most one thread per card (card_id is unique),
// - one general thread per board (partial unique index below),
// - a general thread has no card (check constraint written by hand in the
//   migration, as Prisma cannot describe one).
model Thread {
  id        String     @id @default(uuid()) @db.Uuid
  boardId   String     @map("board_id") @db.Uuid
  cardId    String?    @unique @map("card_id") @db.Uuid
  kind      ThreadKind @default(TOPIC)
  title     String
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  board     Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  // Points at (card, board) so the card must be on the thread's board.
  // NoAction: a card cannot be deleted while a thread is linked to it;
  // CardsService.deleteCard unlinks the thread first so the chat is kept.
  card      Card?      @relation(fields: [cardId, boardId], references: [id, boardId], onDelete: NoAction)

  // Needed by Prisma for the one-to-one link to Card. card_id is already
  // unique on its own, so this adds no new rule.
  @@unique([cardId, boardId])
  @@unique([boardId], map: "threads_one_general_per_board", where: raw("kind = 'GENERAL'"))
  @@index([boardId])
  @@map("threads")
}

// Numbers a card used to have, so they still lead to it. A subtask's number
// changes when it moves to another parent (WEB-12.1 becomes WEB-15.3).
// New numbers are always fresh (from counters that only go up), so an old
// number can never belong to a live card.
model CardNumberAlias {
  projectId  String   @map("project_id") @db.Uuid
  numberPath String   @map("number_path")
  cardId     String   @map("card_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  card       Card     @relation(fields: [cardId, projectId], references: [id, projectId], onDelete: Cascade)

  @@id([projectId, numberPath])
  @@index([cardId])
  @@map("card_number_aliases")
}

// Time someone spent on a card, typed in or from a timer
// (docs/card-features.md, section 6). Rules checked by constraints in the
// migration: 1 minute to 24 hours, and a timer entry has a start and a later end.
model TimeEntry {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  cardId      String    @map("card_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  // The day the work was done, in the person's own time zone.
  workDate    DateTime  @map("work_date") @db.Date
  minutes     Int
  note        String?
  // Set only for entries made by stopping a timer.
  startedAt   DateTime? @map("started_at") @db.Timestamptz(3)
  endedAt     DateTime? @map("ended_at") @db.Timestamptz(3)
  // Set when a timer ran over 24 hours and only 24 were saved. Cleared when
  // the person or an admin edits or confirms the entry.
  needsReview Boolean   @default(false) @map("needs_review")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  // Deleting the project removes its time too.
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Points at (card, project) so the entry is in its card's project.
  // NoAction: a card with logged time cannot be deleted, so hours never
  // quietly disappear. Deleting the whole project still works, as the
  // entries go in the same statement.
  card        Card      @relation(fields: [cardId, projectId], references: [id, projectId], onDelete: NoAction)
  // Restrict: someone's logged time is kept, so they cannot be deleted.
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([cardId])
  @@index([userId, workDate])
  @@index([projectId])
  @@map("time_entries")
}

// A timer that is running now. The person is the primary key, so each
// person has at most one. Stopping it saves a TimeEntry.
model RunningTimer {
  userId    String   @id @map("user_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  cardId    String   @map("card_id") @db.Uuid
  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz(3)
  // The day the timer started, in the person's time zone. The entry it
  // makes is dated this day, even if the timer runs past midnight.
  workDate  DateTime @map("work_date") @db.Date
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Deleting the card stops its timers without saving them.
  card      Card     @relation(fields: [cardId, projectId], references: [id, projectId], onDelete: Cascade)

  @@index([cardId])
  @@index([projectId])
  @@map("running_timers")
}

// Who is assigned to a card (docs/card-features.md, section 3). When a card
// has assignees, exactly one is its owner: at most one is enforced by the
// partial unique index below, at least one by AssigneesService.
model CardAssignee {
  cardId     String        @map("card_id") @db.Uuid
  projectId  String        @map("project_id") @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  isOwner    Boolean       @default(false) @map("is_owner")
  assignedAt DateTime      @default(now()) @map("assigned_at") @db.Timestamptz(3)
  card       Card          @relation(fields: [cardId, projectId], references: [id, projectId], onDelete: Cascade)
  // Points at the project membership, so only members can be assigned.
  member     ProjectMember @relation(fields: [projectId, userId], references: [projectId, userId], onDelete: Cascade)

  @@id([cardId, userId])
  @@unique([cardId], map: "card_assignees_one_owner_per_card", where: raw("is_owner"))
  @@index([projectId, userId])
  @@map("card_assignees")
}

// Label colours come from a fixed set that reads well in light and dark mode.
enum LabelColour {
  GREY
  RED
  ORANGE
  YELLOW
  GREEN
  TEAL
  BLUE
  INDIGO
  PURPLE
  PINK

  @@map("label_colour")
}

// A label shared across a project (docs/card-features.md, section 8).
model Label {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @map("project_id") @db.Uuid
  // Not blank (check constraint in the migration). LabelsService also
  // refuses names that differ only in letter case.
  name      String
  colour    LabelColour
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cards     CardLabel[]

  @@unique([projectId, name])
  // Lets card labels point at (label, project) together.
  @@unique([id, projectId])
  @@map("labels")
}

// Which labels a card has. Card and label are in the same project.
model CardLabel {
  cardId    String @map("card_id") @db.Uuid
  labelId   String @map("label_id") @db.Uuid
  projectId String @map("project_id") @db.Uuid
  card      Card   @relation(fields: [cardId, projectId], references: [id, projectId], onDelete: Cascade)
  label     Label  @relation(fields: [labelId, projectId], references: [id, projectId], onDelete: Cascade)

  @@id([cardId, labelId])
  @@index([labelId])
  @@map("card_labels")
}
